# Copy this file to .env and fill in your own keys. Never commit .env.
# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional: the webhook id from your sandbox app's Webhooks section, so PayPal events reach the room
PAYPAL_WEBHOOK_ID=
# NVIDIA Nemotron on Nebius Token Factory (tokenfactory.nebius.com > API keys)
NEBIUS_API_KEY=
# Spending limits for the AI, in US dollars
DEALROOM_AI_DAILY_USD=1.00
DEALROOM_AI_TOTAL_USD=10
